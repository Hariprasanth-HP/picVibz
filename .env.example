# Database (Prisma) - Supabase Postgres
# Use the pooler host (session mode, port 5432) for both; new Supabase projects
# no longer resolve db.<ref>.supabase.co
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Redis (BullMQ) - Upstash uses rediss:// scheme for TLS
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API key guard
API_KEY=your-api-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://your-public-url.dev

# App (optional, defaults shown)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Uploads & media processing
UPLOAD_MAX_SIZE=1048576000
MEDIA_WORKER_CONCURRENCY=3
SIGNED_URL_EXPIRATION=3600