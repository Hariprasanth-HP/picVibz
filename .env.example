# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/picvibz
DIRECT_URL=postgresql://user:password@localhost:5432/picvibz

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API key guard
API_KEY=your-api-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://your-public-url.dev

# App (optional, defaults shown)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Uploads & media processing
UPLOAD_MAX_SIZE=1048576000
MEDIA_WORKER_CONCURRENCY=3
SIGNED_URL_EXPIRATION=3600