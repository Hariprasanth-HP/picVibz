# Database (Prisma) - Supabase Postgres
# Use the pooler host (session mode, port 5432) for both; new Supabase projects
# no longer resolve db.<ref>.supabase.co
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API key guard
API_KEY=your-api-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://your-public-url.dev

# App (optional, defaults shown)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
CORS_ORIGIN=http://localhost:3001,https://picvibz.onrender.com,http://15.252.122.182
FRONTEND_URL=http://localhost:3001

# Uploads
UPLOAD_MAX_SIZE=1048576000

# Image delivery (Worker)
IMAGE_WORKER_URL=https://picvibz.hari16205.workers.dev
IMAGE_SIGNING_SECRET=your-32-char-secret-minimum

# Signed URL expiration (seconds, default 300 = 5 minutes)
SIGNED_URL_EXPIRATION=300

# Video delivery (Worker)
VIDEO_WORKER_URL=https://picvibz-videos.hari16205.workers.dev

# Cloudflare Queue for video processing
VIDEO_QUEUE_URL=https://api.cloudflare.com/client/v4/accounts/your-account-id/queues/<queue-id>/messages
VIDEO_QUEUE_TOKEN=your-queue-token

# Internal API key for worker callbacks
INTERNAL_API_KEY=your-internal-api-key

# Public API base URL used by the video worker for callbacks (no /api/v1 suffix)
NESTJS_INTERNAL_URL=https://api.picvibz.com