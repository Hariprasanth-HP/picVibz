// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum MediaStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  supabaseUid String?  @unique
  email       String   @unique
  displayName String
  photoURL    String?
  role        String   @default("user")
  eventPasses Int      @default(0)
  autoUpload  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos Photo[]

  @@index([email])
  @@index([supabaseUid])
}



model Event {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("Other")
  date       String   @default("TBD")
  startDate  DateTime?
  endDate    DateTime?
  location   String   @default("TBD")
  coverImage String   @default("")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos Photo[]
  files  File[]

  @@index([createdBy])
}

model File {
  id            String      @id @default(cuid())
  originalName  String
  mimetype      String
  size          Int
  width         Int?
  height        Int?
  originalUrl   String
  previewUrl    String
  thumbnailUrl  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId          String?
  originalKey     String?
  mediumKey       String?
  previewKey      String?
  duration        Int?
  processingError String?
  status          MediaStatus @default(UPLOADING)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  photo Photo?

  @@index([userId])
  @@index([status])
  @@index([eventId])
}

model Photo {
  id         String   @id @default(cuid())
  eventId    String
  fileId     String   @unique
  uploadedBy String
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  file  File  @relation(fields: [fileId], references: [id])
  user  User  @relation(fields: [uploadedBy], references: [id])

  @@index([eventId])
  @@index([uploadedBy])
}