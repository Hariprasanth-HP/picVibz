// This is your Prisma schema file.
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MediaType {
  PHOTO
  VIDEO
}

enum MediaStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  supabaseUid String?   @unique
  email       String    @unique
  displayName String
  photoURL    String?
  role        String    @default("user")
  eventPasses Int       @default(0)
  autoUpload  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uploadedMedia Media[]
  createdEvents Event[] @relation("EventCreator")

  @@index([email])
  @@index([supabaseUid])
}

// ─────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────

model Event {
  id        String    @id @default(cuid())
  name      String
  type      String    @default("Other")
  date      DateTime?
  startDate DateTime?
  endDate   DateTime?
  location  String?
  createdBy String

  creator User @relation("EventCreator", fields: [createdBy], references: [id])

  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([date])
}

// ─────────────────────────────────────────────
// MEDIA
// ─────────────────────────────────────────────

model Media {
  id              String      @id @default(cuid())
  type            MediaType
  originalName    String?
  mimetype        String
  size            BigInt
  width           Int?
  height          Int?
  duration        BigInt?
  originalKey     String
  mediumKey       String?
  previewKey      String?
  thumbnailKey    String?
  videoMp4Key     String?
  posterKey       String?
  previewGifKey   String?
  status          MediaStatus @default(UPLOADING)
  processingError String?
  uploadedBy      String
  uploader        User        @relation(fields: [uploadedBy], references: [id])
  eventId         String?
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([eventId])
  @@index([uploadedBy])
  @@index([status])
  @@index([eventId, type])
  @@index([eventId, status])
}