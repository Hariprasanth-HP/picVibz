// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  displayName  String
  photoURL     String?
  provider     String   @default("email")
  providerId   String?
  role         String   @default("user")
  eventPasses  Int      @default(0)
  autoUpload   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos Photo[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  price       Float
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([price])
}

model Event {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("Other")
  date       String   @default("TBD")
  startDate  DateTime?
  endDate    DateTime?
  location   String   @default("TBD")
  coverImage String   @default("")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos Photo[]

  @@index([createdBy])
}

model File {
  id            String   @id @default(cuid())
  originalName  String
  mimetype      String
  size          Int
  width         Int?
  height        Int?
  originalUrl   String
  previewUrl    String
  thumbnailUrl  String
  createdAt     DateTime @default(now())

  photo Photo?
}

model Photo {
  id         String   @id @default(cuid())
  eventId    String
  fileId     String   @unique
  uploadedBy String
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  file  File  @relation(fields: [fileId], references: [id])
  user  User  @relation(fields: [uploadedBy], references: [id])

  @@index([eventId])
  @@index([uploadedBy])
}