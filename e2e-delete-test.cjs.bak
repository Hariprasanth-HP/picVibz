
const fs = require('fs');
const sharp = require('sharp');
const { PrismaClient } = require('@prisma/client');
const { S3Client, HeadObjectCommand } = require('@aws-sdk/client-s3');

const API = 'http://localhost:8080/api/v1';
const SB = process.env.SUPABASE_URL;
const SKEY = process.env.SUPABASE_SERVICE_ROLE_KEY;
const EMAIL = `e2e-delete-${Date.now()}@test.local`;

const s3 = new S3Client({
  region: 'auto',
  endpoint: `https://${process.env.R2_ACCOUNT_ID}.r2.cloudflarestorage.com`,
  credentials: { accessKeyId: process.env.R2_ACCESS_KEY_ID, secretAccessKey: process.env.R2_SECRET_ACCESS_KEY },
});
const prisma = new PrismaClient();

async function jreq(method, path, body, token) {
  const headers = { 'Content-Type': 'application/json' };
  if (token) headers.Authorization = `Bearer ${token}`;
  const r = await fetch(`${API}${path}`, { method, headers, body: body ? JSON.stringify(body) : undefined });
  const t = await r.text();
  return { status: r.status, data: t ? JSON.parse(t) : null };
}

(async () => {
  // 1. create throwaway user
  const ur = await fetch(`${SB}/auth/v1/admin/users`, {
    method: 'POST',
    headers: { apikey: SKEY, Authorization: `Bearer ${SKEY}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: EMAIL, password: 'TestPass!123', email_confirm: true }),
  });
  if (!ur.ok) throw new Error('user create failed: ' + (await ur.text()));
  const user = await ur.json();
  console.log('1. created user', user.id);

  // 2. login
  let login = await jreq('POST', '/auth/login', { email: EMAIL, password: 'TestPass!123' });
  if (login.status !== 201 && login.status !== 200) throw new Error('login failed ' + JSON.stringify(login));
  const token = login.data.data?.session?.access_token || login.data.session?.access_token || login.data.accessToken || login.data.token;
  console.log("2. login resp", JSON.stringify(login.data).slice(0,300)); console.log("token len", token ? token.length : "none");
  let evr = await jreq("POST", "/events", { name: "E2E Delete Test" }, token);
  console.log("event resp", evr.status, JSON.stringify(evr.data));
  const eventId = evr.data?.id;
  console.log("eventId", eventId);

  // 3. create event
  let ev = await jreq('POST', '/events', { name: 'E2E Delete Test' }, token);
  console.log('3. created event', eventId);

  // 4. upload via multipart (legacy scheme)
  const buf = await sharp({ create: { width: 40, height: 30, channels: 3, background: { r: 255, g: 0, b: 0 } } }).jpeg().toBuffer();
  const fd = new FormData();
  fd.append('file', new Blob([buf], { type: 'image/jpeg' }), 'test.jpg');
  const ur2 = await fetch(`${API}/events/${eventId}/photos`, { method: 'POST', headers: { Authorization: `Bearer ${token}` }, body: fd });
  const photo = await ur2.json(); console.log("upload resp status", ur2.status, "keys", Object.keys(photo||{}));
  console.log('4. uploaded photo', photo.id, 'fileId', photo.fileId);

  // 5. verify R2 objects exist
  const legacyKeys = [`uploads/${photo.fileId}/original.jpg`, `uploads/${photo.fileId}/preview.jpg`, `uploads/${photo.fileId}/thumbnail.jpg`];
  const before = [];
  for (const k of legacyKeys) {
    try { await s3.send(new HeadObjectCommand({ Bucket: process.env.R2_BUCKET, Key: k })); before.push(true); }
    catch { before.push(false); }
  }
  console.log('5. R2 objects exist before delete:', before.join(','));

  // 6. delete
  let del = await jreq('DELETE', `/events/${eventId}/photos/${photo.id}`, null, token);
  console.log('6. delete status', del.status, JSON.stringify(del.data));

  // 7. verify DB rows gone
  const photoRow = await prisma.photo.findUnique({ where: { id: photo.id } });
  const fileRow = await prisma.file.findUnique({ where: { id: photo.fileId } });
  console.log('7. Photo row gone:', !photoRow, '| File row gone:', !fileRow);

  // 8. verify R2 objects gone
  const after = [];
  for (const k of legacyKeys) {
    try { await s3.send(new HeadObjectCommand({ Bucket: process.env.R2_BUCKET, Key: k })); after.push(true); }
    catch { after.push(false); }
  }
  console.log('8. R2 objects gone after delete:', after.map(v => !v).join(','));

  // cleanup: delete event + user
  await jreq('DELETE', `/events/${eventId}`, null, token).catch(() => {});
  await fetch(`${SB}/auth/v1/admin/users/${user.id}`, { method: 'DELETE', headers: { apikey: SKEY, Authorization: `Bearer ${SKEY}` } });
  console.log('9. cleaned up event + user');
  await prisma.$disconnect();
})().catch(e => { console.error('FAIL:', e.message); process.exit(1); });
